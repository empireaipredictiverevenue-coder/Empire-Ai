      if (Math.random() > 0.7) appendLog('New video variant generated', 'ok');
    }, 4000);

    setCountdown(formatCountdown());
    return () => { clearInterval(iv); clearInterval(variantIv); };
  }, []);

  const METRICS = [
    {
      label:    'PREDICTIVE REVENUE',
      value:    '$42,900',
      sub:      '+12% FROM LAST STORM',
      subColor: '#39ff14',
