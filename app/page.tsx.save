                    className="font-['Orbitron',monospace] text-[10px] font-bold tracking-widest"
                    style={{
                      color: c === 'cyan' ? '#00f5ff' : '#39ff14',
                      textShadow: c === 'cyan' ? '0 0 8px rgba(0,245,255,0.4)' : '0 0 8px rgba(57,255,20,0.4)',
                    }}
                  >
                    {value}
                  </span>
                </div>
              ))}
            </div>
          </div>

          {/* ── METRIC CARDS ── */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            {METRICS.map(({ label, value, sub, subColor, variant }) => (
              <div
                key={label}
                className="metric-card relative bg-[#040d0d] border border-[rgba(0,245,255,0.22)] p-6 overflow-hidden"
              >
                <div className="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-[#39ff14] via-[#00f5ff] to-transparent" />
                <div className="absolute top-0 left-0 bottom-0 w-0.5 bg-gradient-to-b from-[#39ff14] to-transparent opacity-30" />
                <p className="text-[8px] tracking-[3px] text-[rgba(0,245,255,0.4)] uppercase mb-3">{label}</p>
                <p
                  className="metric-val font-['Orbitron',monospace] text-4xl font-black tracking-tight mb-2"
                  style={{
                    color: variant === 'cyan' ? '#00f5ff' : '#39ff14',
                    textShadow: variant === 'cyan'
                      ? '0 0 20px rgba(0,245,255,0.5)'
                      : '0 0 20px rgba(57,255,20,0.5)',
                  }}
                >
                  {value}
                </p>
                <p className="text-[10px] tracking-widest uppercase" style={{ color: subColor }}>
                  {sub}
                </p>
              </div>
            ))}
          </div>

          {/* ── BANNER STRATEGY + SNIPERS ── */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">

            {/* Ugly Banner Strategy */}
            <div className="relative bg-[#040d0d] border border-[rgba(0,245,255,0.22)] p-6 overflow-hidden">
              <div className="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-[#39ff14] via-[#00f5ff] to-transparent" />
              <div className="absolute inset-0 pointer-events-none"
                style={{ background:'radial-gradient(ellipse at top left,rgba(57,255,20,0.04) 0%,transparent 60%)' }} />
              <p className="text-[8px] tracking-[3px] text-[rgba(0,245,255,0.4)] uppercase mb-1">// UGLY BANNER STRATEGY</p>
              <h3
                className="font-['Orbitron',monospace] text-lg font-black tracking-[3px] text-[#39ff14] mb-2 uppercase"
                style={{ textShadow:'0 0 12px rgba(57,255,20,0.4)' }}
              >
                ACTIVE
              </h3>
              <p className="text-[11px] tracking-wide text-[rgba(0,245,255,0.6)] leading-relaxed mb-4">
                AI is currently generating high-conversion video variants for targeted niches.
              </p>
              <div className="flex items-end gap-3">
                <div>
                  <p className="text-[8px] tracking-[2px] text-[rgba(0,245,255,0.4)] uppercase mb-1">VARIANTS GENERATED</p>
                  <p
                    className="font-['Orbitron',monospace] text-3xl font-black tracking-tight"
                    style={{ color:'#39ff14', textShadow:'0 0 14px rgba(57,255,20,0.5)' }}
                  >
                    {variants}
                  </p>
                </div>
                <div className="flex gap-1 mb-1">
                  {[...Array(5)].map((_, i) => (
                    <div
                      key={i}
                      className="w-1.5 rounded-full"
                      style={{
                        height: `${12 + i * 6}px`,
                        background: i < 4 ? '#39ff14' : 'rgba(57,255,20,0.2)',
                        boxShadow: i < 4 ? '0 0 6px rgba(57,255,20,0.4)' : 'none',
                        animation: `pulse-dot ${1.5 + i * 0.3}s ease-in-out infinite`,
                      }}
                    />
                  ))}
                </div>
              </div>
            </div>

            {/* Storm Sniper Feed */}
            <div className="relative bg-[#040d0d] border border-[rgba(0,245,255,0.22)] p-6 overflow-hidden">
              <div className="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-[#00f5ff] via-[#39ff14] to-transparent" />
              <p className="text-[8px] tracking-[3px] text-[rgba(0,245,255,0.4)] uppercase mb-3">// STORM SNIPER FEED</p>
              <div className="flex flex-col gap-2">
                {[
                  { zone: 'FLORIDA — HAIL STORM',    snipers: 6, status: 'LIVE',     color: '#39ff14' },
                  { zone: 'TEXAS — WIND EVENT',      snipers: 4, status: 'SCANNING', color: '#ffb400' },
                  { zone: 'GEORGIA — STORM WATCH',   snipers: 4, status: 'ARMED',    color: '#39ff14' },
                ].map(({ zone, snipers: s, status, color }) => (
                  <div
                    key={zone}
                    className="flex justify-between items-center px-3 py-2.5 border border-[rgba(0,245,255,0.1)] hover:border-[rgba(0,245,255,0.3)] transition-colors duration-150"
                  >
                    <div>
                      <p className="text-[10px] tracking-widest text-[rgba(0,245,255,0.7)]">{zone}</p>
                      <p className="text-[8px] tracking-[2px] text-[rgba(0,245,255,0.35)] mt-0.5">{s} SNIPERS DEPLOYED</p>
                    </div>
                    <span
                      className="text-[9px] tracking-widest font-bold px-2 py-1 border"
                      style={{
                        color,
                        borderColor: color + '44',
                        background:  color + '11',
                        textShadow: `0 0 8px ${color}66`,
                      }}
                    >
                      {status}
                    </span>
                  </div>
                ))}
              </div>
            </div>

          </div>

          {/* ── AUDIT LOG ── */}
          <div
            role="log" aria-live="off"
            className="bg-[#040d0d] border border-[rgba(0,245,255,0.22)] px-4 py-3 max-h-[72px] overflow-y-auto flex flex-col-reverse gap-0.5"
          >
            <p className="text-[8px] tracking-[3px] text-[rgba(0,245,255,0.4)] uppercase mb-1">// SYSTEM LOG</p>
            {log.map((e) => (
              <div key={e.id} className="flex gap-2.5 text-[9px] tracking-wide">
                <span className="text-[rgba(57,255,20,0.3)] shrink-0">{e.time}</span>
                <span className={
                  e.type === 'ok'   ? 'text-[#39ff14]' :
                  e.type === 'warn' ? 'text-[#ffb400]' :
                  'text-[rgba(0,245,255,0.35)]'
                }>{e.message}</span>
              </div>
            ))}
          </div>

          {/* ── CTA BUTTONS ── */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            {[
              { label: 'OPEN HERMES TERMINAL', href: '/predictive', variant: 'green' },
              { label: 'DISPATCH STORM ALERT', href: '/storm',      variant: 'cyan'  },
              { label: 'JOIN THE FLEET',        href: '/join',       variant: 'green' },
            ].map(({ label, href, variant }) => (
              
                key={label}
                href={href}
                className="relative overflow-hidden border font-['Orbitron',monospace] text-[10px] font-bold tracking-[3px] py-4 uppercase text-center block active:scale-95 transition-all duration-150 group"
                style={{
                  borderColor: variant === 'cyan' ? '#00c8d4' : '#2dd10e',
                  color:       variant === 'cyan' ? '#00f5ff' : '#39ff14',
                  textShadow:  variant === 'cyan'
                    ? '0 0 8px rgba(0,245,255,0.5)'
                    : '0 0 8px rgba(57,255,20,0.5)',
                }}
              >
                <span
                  className="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-150"
                  style={{ background: variant === 'cyan'
                    ? 'linear-gradient(135deg,#00f5ff,#39ff14)'
                    : 'linear-gradient(135deg,#39ff14,#00f5ff)',
                  }}
                  aria-hidden="true"
                />
